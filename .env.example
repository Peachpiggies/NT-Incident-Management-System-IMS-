# Application
APP_NAME=NT Incident Management System
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=ims
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=ims
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ims:change-me-for-local-development@db:5432/ims

# Database connection pool (defaults are reasonable for a small production
# deployment; raise DB_POOL_SIZE if backend replicas increase, keeping
# pool_size * replica_count comfortably under postgres's max_connections)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# API
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1
