# Application
APP_NAME=NT Incident Management System
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=ims
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=ims
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ims:change-me-for-local-development@db:5432/ims

# API
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1
