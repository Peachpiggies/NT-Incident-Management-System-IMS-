# Database
POSTGRES_USER = postgres
POSTGRES_PASSWORD = postgres
POSTGRES_DB = ims_dev
POSTGRES_HOST = db
POSTGRES_PORT = 5432
DATABASE_URL = postgresql+asyncpg://postgres:postgres@db:5432/ims_dev

# Backend
PYTHON_ENV = development
JWT_SECRET = replace-with-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES = 60

# Frontend
NEXT_PUBLIC_API_URL = http://localhost:8000/api/v1

# CI / Secrets placeholders
# DO NOT commit production secrets to the repo. Use a secret manager or repository secrets.